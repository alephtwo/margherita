{
  "include": ["src", "vite.config.mts"],
  "compilerOptions": {
    "lib": ["dom", "esnext"],
    "types": ["vite/client"],

    // Build
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  }
}
